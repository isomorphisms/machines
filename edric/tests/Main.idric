module Main

import Data.Machine
import System

%default partial

check : (Eq a, Show a) ⇒ String → a → a → IO Bool
check name expected actual =
  if expected == actual
     then do
       putStrLn ("ok: " ++ name)
       pure True
     else do
       putStrLn ("FAIL: " ++ name)
       putStrLn ("  expected " ++ show expected)
       putStrLn ("  actual   " ++ show actual)
       pure False

pipelineExample : List Nat
pipelineExample =
  collect (source [1, 2, 3] ~> taking 2 ~> mapping (\x ⇒ x + 1))

bufferExample : List (List Nat)
bufferExample =
  collect (source [1, 2, 3, 4, 5] ~> buffered 3)

scanExample : List Nat
scanExample =
  collect (source [1, 2, 3, 4, 5] ~> scan (+) 0)

foldExample : List Nat
foldExample =
  collect (source [1, 2, 3, 4, 5] ~> fold (+) 0)

zippingExample : List (Nat, String)
zippingExample = runTee [1, 2] ["a", "b", "c"] zipping

teeCompositionExample : List (Nat, String)
teeCompositionExample =
  runTee [1, 2, 3]
         ["a", "b", "c"]
         (tee (mapping (\x ⇒ x + 10))
              (filtered (\x ⇒ x /= "b"))
              zipping)

countingMealy : Mealy Char (Nat, Char)
countingMealy =
  unfoldMealy (\index, char ⇒ ((index, char), S index)) 0

mealyExample : List (Nat, Char)
mealyExample =
  collect (source ['w', 'o', 'r', 'd'] ~> autoMealy countingMealy)

runningTotalMoore : Moore Nat Nat
runningTotalMoore =
  unfoldMoore (\total ⇒ (total, \input ⇒ total + input)) 0

mooreExample : List Nat
mooreExample =
  collect (source [1, 2, 3] ~> autoMoore runningTotalMoore)

main : IO ()
main = do
  pipelineOk ← check "source/taking/mapping" [2, 3] pipelineExample
  bufferOk ← check "buffered final short chunk" [[1, 2, 3], [4, 5]] bufferExample
  scanOk ← check "scan emits seed" [0, 1, 3, 6, 10, 15] scanExample
  foldOk ← check "fold emits final state" [15] foldExample
  zippingOk ← check "typed two-input zipping" [(1, "a"), (2, "b")] zippingExample
  teeOk ← check "tee precomposition"
                [(11, "a"), (12, "c")]
                teeCompositionExample
  mealyOk ← check "Mealy counting example"
                  [(0, 'w'), (1, 'o'), (2, 'r'), (3, 'd')]
                  mealyExample
  mooreOk ← check "Moore running total" [0, 1, 3, 6] mooreExample
  if pipelineOk && bufferOk && scanOk && foldOk && zippingOk && teeOk && mealyOk && mooreOk
     then putStrLn "all Edric machine checks passed"
     else exitFailure
