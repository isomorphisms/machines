module Data.Machine.Tee

import Data.Machine.Core
import Data.Machine.Process

%default partial

||| Typed request family for a deterministic two-input machine.
public export
data T : Type → Type → Type → Type where
  L : T a b a
  R : T a b b

public export
Tee : Type → Type → Type → Type
Tee a b output = Machine (T a b) output

||| Precompose one Process onto each input of a Tee.
||| This is the pure specialization of Kmett's `tee`.
public export
tee : Process a a1 → Process b b1 → Tee a1 b1 output → Tee a b output
tee leftProcess rightProcess Stop = Stop
tee leftProcess rightProcess (Yield output rest) =
  Yield output (tee leftProcess rightProcess rest)
tee leftProcess rightProcess (Await L receive starved) =
  case leftProcess of
    Stop ⇒ tee Stop rightProcess starved
    Yield leftValue rest ⇒ tee rest rightProcess (receive leftValue)
    Await Input receiveLeft starvedLeft ⇒
      Await L
            (\input ⇒ tee (receiveLeft input)
                          rightProcess
                          (Await L receive starved))
            (tee starvedLeft rightProcess (Await L receive starved))
tee leftProcess rightProcess (Await R receive starved) =
  case rightProcess of
    Stop ⇒ tee leftProcess Stop starved
    Yield rightValue rest ⇒ tee leftProcess rest (receive rightValue)
    Await Input receiveRight starvedRight ⇒
      Await R
            (\input ⇒ tee leftProcess
                          (receiveRight input)
                          (Await R receive starved))
            (tee leftProcess starvedRight (Await R receive starved))

public export
addL : Process a b → Tee b c output → Tee a c output
addL process = tee process echo

public export
addR : Process b c → Tee a c output → Tee a b output
addR process = tee echo process

||| One left request followed by one right request and one combined output.
public export
zipWithT : (a → b → c) → Plan (T a b) c ()
zipWithT combine =
  planBind (await L) (\leftValue ⇒
    planBind (await R) (\rightValue ⇒
      yield (combine leftValue rightValue)))

||| Zip the two inputs, stopping when either input starves.
public export
zipWith : (a → b → c) → Tee a b c
zipWith combine = repeatedly (zipWithT combine)

public export
zipping : Tee a b (a, b)
zipping = zipWith (\leftValue, rightValue ⇒ (leftValue, rightValue))

||| Pure runner for the two-input request family. This helper is specific to the
||| Edric port and makes typed Tee behavior easy to regression-test.
public export
runTee : List a → List b → Tee a b output → List output
runTee lefts rights Stop = []
runTee lefts rights (Yield output rest) = output :: runTee lefts rights rest
runTee [] rights (Await L receive starved) = runTee [] rights starved
runTee (leftValue :: lefts) rights (Await L receive starved) =
  runTee lefts rights (receive leftValue)
runTee lefts [] (Await R receive starved) = runTee lefts [] starved
runTee lefts (rightValue :: rights) (Await R receive starved) =
  runTee lefts rights (receive rightValue)
